    "/metrics": {
      "get": {
        "description": "Returns Prometheus text exposition; production deployments require a bearer token.",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "description": "RFC 4180 CSV stream of matching payment streams.",
